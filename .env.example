# Modelo LLM: HuggingFace Inference API (ver app/config.py)
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct

# Gemini (Google AI Studio, opcional) — tiene la prioridad más alta si se
# configura. gemini-1.5-flash ya no existe (retirado); gemini-2.5-flash es el
# equivalente gratuito y estable actual.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Groq (opcional, https://console.groq.com/keys): tier gratuito generoso
# (~30 RPM / 14.400 req/día) e inferencia muy rápida. Entra en la cadena de
# respaldo después de Gemini si ambas están configuradas.
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.6-27b

# Cerebras (opcional, https://cloud.cerebras.ai): otro tier gratuito rápido
# (~30 RPM / 1M tokens/día). Mismo modelo que Groq con cuota independiente.
CEREBRAS_API_KEY=
CEREBRAS_MODEL_ID=gpt-oss-120b

# OpenRouter (opcional, tiene prioridad sobre HuggingFace si se configura).
# Modelos gratuitos si no quieres cargar crédito (cupo y disponibilidad menos
# confiables que un modelo pago: los ":free" de OpenRouter se saturan y quedan
# temporalmente no disponibles). OPENROUTER_FALLBACK_MODEL_IDS es una cadena
# de respaldo separada por comas — se prueba cada uno en orden si el anterior
# falla, antes de devolver el error al usuario.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODEL_IDS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-nano-9b-v2:free

# URL base de la API del sistema de vacaciones (C# MVC). 5051 es el puerto
# real del perfil "http" en launchSettings.json de ese proyecto en desarrollo,
# no 5000.
VACACIONES_API_URL=http://localhost:5051

# API key que exige ApiKeyAuthFilter del lado C# (header X-Api-Key). Debe
# coincidir con AgenteIA:ApiKey configurado en ese proyecto.
VACACIONES_API_KEY=

# Origen permitido por CORS para las llamadas del sistema C# MVC
CORS_ALLOWED_ORIGIN=http://localhost:5001

# Límite de pasos por agente (cada paso = 1 llamada al modelo que reenvía
# todo el historial: menos pasos = menos tokens por mensaje). Si son muy
# bajos el agente corta a mitad de tarea sin responder bien.
MAX_STEPS_ORQUESTADOR=10
MAX_STEPS_SOLICITUDES=4
MAX_STEPS_VIAJE=8

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
