# URL del sistema de vacaciones (otro repositorio, C# MVC).
BASE_URL_VACACIONES_API=http://localhost:5000
# true = respuestas simuladas (desarrollo sin el sistema MVC); false = llama al MVC real.
USE_MOCK_VACACIONES_API=false
# API Key para la API REST del sistema de vacaciones (header X-Api-Key en appsettings.json del monolito C#).
API_KEY_VACACIONES_API=dev-key-vacaciones-agent1

# Modelo de IA (smolagents / OpenRouter)
MODEL_PROVIDER=openrouter
MODEL_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=tu-modelo
# Modelos de respaldo separados por coma (opcional), si el principal agota intentos.
MODEL_FALLBACK=

# Servidor
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=*